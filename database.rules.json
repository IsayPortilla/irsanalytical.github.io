{
  "rules": {
    ".read": false,
    ".write": false,

    "nombres_empresa": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "relacion_empresa_submarca": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "relacion_submarca_categoria": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "data_productos": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "configuracion": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "users": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$uid": {
        ".read": "auth !== null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        ".write": "auth !== null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        "role": {
          ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'usuario') && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() === false && newData.val() === 'usuario') || newData.val() === data.val())"
        },

        "activo": {
          ".validate": "newData.isBoolean() && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() === false && newData.val() === true) || newData.val() === data.val())"
        },

        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "username": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "createdAt": { ".validate": "newData.isString()" },
        "lastLogin": { ".validate": "newData.isString()" },

        "$otro": { ".validate": false }
      }
    }
  }
}
